# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_FACTCHECK_API_KEY: Google Cloud API key with the Fact Check Tools API enabled.
# Used for direct claim verification against publisher fact-check databases, separate from GEMINI_API_KEY.
GOOGLE_FACTCHECK_API_KEY="MY_GOOGLE_FACTCHECK_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SAPLING_API_KEY: Sapling AI Detector API key for direct text AI probability analysis.
SAPLING_API_KEY="MY_SAPLING_API_KEY"

# WINSTON_API_KEY: Winston AI API key for text and image AI generation detection.
WINSTON_API_KEY="MY_WINSTON_API_KEY"

# EDENAI_API_KEY / EDLIN_API_KEY: Eden AI / Edlin API key for fallback AI detection.
EDENAI_API_KEY="MY_EDENAI_API_KEY"
EDLIN_API_KEY="MY_EDLIN_API_KEY"

# IMAGGA_API_KEY & IMAGGA_API_SECRET: Imagga API credentials for image tagging and visual media analysis.
IMAGGA_API_KEY="acc_dc0c86eed205c36"
IMAGGA_API_SECRET="d8a1f6eb9152488255ed24ad261f1eb7"
